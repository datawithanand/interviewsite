# For SQLite (default, zero-setup dev/test):
DATABASE_URL="file:./dev.db"
# For PostgreSQL in production, switch the provider in prisma/schema.prisma to
# "postgresql" and set:
# DATABASE_URL="postgresql://user:password@localhost:5432/interviewsite"
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="8h"
PORT=4000
NODE_ENV=development
